{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the portal (needs: npm run emulators)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "runtimeArgs": ["--watch"],
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "listening on (https?://\\S+)", "uriFormat": "http://localhost:3000", "action": "openExternally" },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Quick-look demo (no Java, nothing saved)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo.js",
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "listening on (https?://\\S+)", "uriFormat": "http://localhost:3000", "action": "openExternally" },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run the tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "--test-concurrency=1"],
      "args": ["test/acceptance.test.js", "test/rules.test.js", "test/functions.test.js"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
