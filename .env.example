# Optional settings. Copy this file to .env only if you need one of them.
# (Don't add PORT or names starting with FIREBASE_, X_GOOGLE_ or FUNCTION_: Cloud Functions reserves them.)

# Sign-out after inactivity, in minutes
IDLE_MINUTES_STAFF=10
IDLE_MINUTES_MANAGER=30

# "Draft 5 questions from the content" in the document editor. Leave empty to hide the button.
ANTHROPIC_API_KEY=
